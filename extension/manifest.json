{
  "manifest_version": 3,
  "name": "LinkedIn Insight V3",
  "version": "3.0.0",
  "description": "Secure AI-powered LinkedIn networking analysis with privacy-first design and HMAC authentication.",
  "default_locale": "en",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "background"
  ],
  "host_permissions": [
    "https://*.linkedin.com/*",
    "https://*.n8n.cloud/*",
    "https://chmones.app.n8n.cloud/*"
  ],
  "action": {
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.linkedin.com/*"
      ],
      "js": [
        "content_scripts/linkedin_scraper.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/core/security/*.js",
        "src/services/*.js",
        "src/utils/*.js",
        "src/popup/components/*.js",
        "ui/*.html",
        "ui/*.css"
      ],
      "matches": [
        "https://*.linkedin.com/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "settings/settings.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://fonts.googleapis.com; font-src 'self' data: https:; img-src 'self' data: https://via.placeholder.com https://i.imgur.com https:; connect-src 'self' https://*.n8n.cloud https://chmones.app.n8n.cloud;"
  },
  "externally_connectable": {
    "matches": [
      "https://*.n8n.cloud/*",
      "https://chmones.app.n8n.cloud/*"
    ]
  }
}